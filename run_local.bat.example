@echo off
REM CGV 감시 봇. 이 파일을 더블클릭하면 바로 돈다.
REM run_local.bat 으로 복사한 뒤 토큰과 채팅 ID 를 채워 넣고 더블클릭한다.
REM 이 파일은 cp949 로 저장해야 한다. UTF-8 이면 cmd 가 한글을 깨뜨린다.
cd /d "%~dp0"
title CGV 용아맥 감시봇

REM 이미 돌고 있는 인스턴스를 먼저 정리한다. 둘이 같이 돌면 텔레그램이
REM 409 Conflict 를 내며 명령을 서로 뺏어가고, state.json 도 덮어쓴다.
powershell -NoProfile -Command "Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'python.exe' -and $_.CommandLine -like '*cgv_watch*' } | ForEach-Object { Write-Host ('stop old instance: PID ' + $_.ProcessId); Stop-Process -Id $_.ProcessId -Force }"

set TELEGRAM_BOT_TOKEN=여기에_봇토큰
set TELEGRAM_CHAT_ID=여기에_채팅ID
set PYTHONIOENCODING=utf-8
set PYTHONUNBUFFERED=1

echo.
echo   CGV 용아맥 감시봇을 시작합니다. 이 창을 닫으면 봇도 멈춥니다.
echo.
python cgv_watch.py --loop --interval 30 --jitter 0.4

echo.
echo   봇이 종료됐습니다. 아무 키나 누르면 창이 닫힙니다.
pause > nul
